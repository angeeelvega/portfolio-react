---
import ExperienceItem from '@/components/home/ExperienceItem.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { experience } from '@/data/experience';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section>
  <SectionHeading id="experience">{t('section.experience')}</SectionHeading>

  {
    /* Rendered in the order defined in the data file — not sorted by date, so
      the order stays an editorial choice. */
  }
  <div class="space-y-10">
    {experience.map((company) => <ExperienceItem company={company} lang={lang} />)}
  </div>
</section>
