---
import BulletList from '@/components/ui/BulletList.astro';
import ExternalLink from '@/components/ui/ExternalLink.astro';
import type { Company } from '@/data/experience';
import type { Locale } from '@/i18n/config';
import { formatDateRange } from '@/i18n/utils';

interface Props {
  company: Company;
  lang: Locale;
}

const { company, lang } = Astro.props;
---

<div>
  <h3 class="text-[0.9375rem] font-medium">
    {company.url ? <ExternalLink href={company.url}>{company.name}</ExternalLink> : company.name}
  </h3>

  <div class="mt-3 space-y-5">
    {
      company.roles.map((role) => (
        <div>
          <p class="text-[0.9375rem]">{role.title[lang]}</p>
          <p class="text-muted-foreground font-mono text-xs tabular-nums">
            {formatDateRange(role.start, role.end, lang)}
          </p>
          <BulletList items={role.bullets[lang]} />
        </div>
      ))
    }
  </div>
</div>
