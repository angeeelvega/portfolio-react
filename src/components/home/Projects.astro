---
import ProjectCard from '@/components/home/ProjectCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ExternalLink from '@/components/ui/ExternalLink.astro';
import { githubUrl, projects } from '@/data/projects';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section>
  <SectionHeading id="projects">{t('section.projects')}</SectionHeading>

  <div class="space-y-10">
    {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
  </div>

  <p class="mt-8 text-sm">
    <ExternalLink href={githubUrl}>{t('projects.more')}</ExternalLink>
  </p>
</section>
