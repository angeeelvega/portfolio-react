---
import SectionHeading from '@/components/SectionHeading.astro';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import { tools } from '@/data/skills';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section>
  <SectionHeading id="skills">{t('section.skills')}</SectionHeading>

  <ul class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm sm:grid-cols-3">
    {
      tools.map((tool) => (
        <li class="text-muted-foreground hover:text-foreground flex items-start gap-2 transition-colors">
          {/* Tools without an available mark keep the slot so names stay aligned. */}
          {tool.icon ? (
            <BrandIcon icon={tool.icon} class="mt-0.5" />
          ) : (
            <span class="mt-0.5 size-4 shrink-0" />
          )}
          {/* Wrap rather than truncate: an ellipsis on a two-column mobile grid
              hides the end of names like "Google Analytics". */}
          <span class="leading-tight">{tool.name}</span>
        </li>
      ))
    }
  </ul>
</section>
