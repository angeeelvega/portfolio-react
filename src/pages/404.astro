---
import { LOCALES } from '@/i18n/config';
import { localizePath, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';

/**
 * A static build emits exactly one 404.html, so it cannot be locale-aware.
 * It shows both languages rather than guessing wrong for half the visitors.
 */
const t = useTranslations('en');
---

<BaseLayout lang="en" title="404 — Ángel Vega" description={t('404.body')} alternate={null} noindex>
  <section class="space-y-6">
    <p class="text-muted-foreground font-mono text-sm">404</p>

    {
      LOCALES.map((locale) => {
        const translate = useTranslations(locale);
        return (
          <div class="space-y-1">
            <h1 lang={locale} class="text-lg font-semibold">
              {translate('404.title')}
            </h1>
            <p lang={locale} class="text-muted-foreground">
              {translate('404.body')}
            </p>
            <p class="pt-1 text-sm">
              <a
                href={localizePath('/', locale)}
                class="decoration-border hover:decoration-brand hover:text-brand underline underline-offset-[3px] transition-colors"
              >
                {translate('404.home')}
              </a>
            </p>
          </div>
        );
      })
    }
  </section>
</BaseLayout>
